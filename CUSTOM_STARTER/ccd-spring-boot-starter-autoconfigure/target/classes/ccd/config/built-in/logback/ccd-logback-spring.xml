<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration debug="true">

	<springProfile name="!(local|test|error-test|sit|uat)">
	    <include resource="ccd/config/built-in/logback/default/logback-prod.xml" />
	</springProfile>

	<springProfile name="local|test|error-test">
	    <include resource="ccd/config/built-in/logback/default/logback-local.xml" />
	</springProfile>

	<springProfile name="sit">
	    <include resource="ccd/config/built-in/logback/default/logback-sit.xml"/>
	</springProfile>

	<springProfile name="uat">
	    <include resource="ccd/config/built-in/logback/default/logback-uat.xml"/>
	</springProfile>

	<springProfile name="prod">
	    <include resource="ccd/config/built-in/logback/default/logback-prod.xml"/>
	</springProfile>

</configuration>
